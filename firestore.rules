rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function rawSignedIn() {
      return request.auth != null;
    }

    function isOwnerAdmin() {
      return rawSignedIn()
        && exists(/databases/$(database)/documents/profileIds/3228667330)
        && get(/databases/$(database)/documents/profileIds/3228667330).data.uid == request.auth.uid;
    }

    function hasStaffRole(role) {
      return rawSignedIn()
        && exists(/databases/$(database)/documents/staffAccess/$(request.auth.uid))
        && get(/databases/$(database)/documents/staffAccess/$(request.auth.uid)).data.role == role
        && get(/databases/$(database)/documents/staffAccess/$(request.auth.uid)).data.active == true;
    }
    function isSuperAdmin() { return isOwnerAdmin() || hasStaffRole("admin"); }
    function isSupportAgent() { return signedIn() && (isSuperAdmin() || hasStaffRole("support")); }
    match /staffAccess/{uid} {
      allow get: if rawSignedIn() && (request.auth.uid == uid || isOwnerAdmin());
      allow list: if isOwnerAdmin();
      allow create, update: if isOwnerAdmin()
        && request.resource.data.keys().hasOnly(["role","active","displayName","permissions","grantedBy","updatedAt"])
        && request.resource.data.role in ["admin","support"]
        && (!('permissions' in request.resource.data) || (request.resource.data.permissions is map
          && request.resource.data.permissions.keys().hasOnly(['chatModeration','banAccounts','deleteAccounts'])
          && request.resource.data.permissions.get('chatModeration',false) is bool
          && request.resource.data.permissions.get('banAccounts',false) is bool
          && request.resource.data.permissions.get('deleteAccounts',false) is bool))
        && request.resource.data.active is bool
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.grantedBy == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(uid));
      allow delete: if isOwnerAdmin();
    }

    function isBlocked() {
      return rawSignedIn()
        && !isSuperAdmin()
        && exists(/databases/$(database)/documents/blockedUsers/$(request.auth.uid));
    }

    function signedIn() {
      return rawSignedIn() && !isBlocked();
    }

    function isTeacher() {
      return signedIn() && (
        isSuperAdmin()
        || request.auth.token.firebase.sign_in_provider == "google.com"
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "teacher")
      );
    }

    function ownsClass(classId) {
      return isTeacher()
        && get(/databases/$(database)/documents/classes/$(classId)).data.ownerId
           == request.auth.uid;
    }

    function isCoTeacher(classId) {
      return isTeacher()
        && exists(/databases/$(database)/documents/classes/$(classId)/teachers/$(request.auth.uid));
    }

    function managesClass(classId) {
      return isSuperAdmin() || ownsClass(classId) || isCoTeacher(classId);
    }

    function isClassMember(classId) {
      return signedIn()
        && exists(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid));
    }

    function ownsExam(examId) {
      return isSuperAdmin() || (
        isTeacher()
        && get(/databases/$(database)/documents/exams/$(examId)).data.ownerId
           == request.auth.uid
      );
    }

    function ownsAttempt(attemptId) {
      return signedIn()
        && get(/databases/$(database)/documents/attempts/$(attemptId)).data.studentUid
           == request.auth.uid;
    }

    function ownsCompetition(compId) {
      return isSuperAdmin() || (
        isTeacher()
        && get(/databases/$(database)/documents/competitions/$(compId)).data.ownerId
           == request.auth.uid
      );
    }

    function canJoinCompetition(compId) {
      let c = get(/databases/$(database)/documents/competitions/$(compId)).data;
      return isSuperAdmin()
        || !("targetType" in c)
        || c.targetType == "all"
        || (c.targetType == "class" && isClassMember(c.targetClassId));
    }

    function canReadTarget(targetType, targetClassId) {
      return isSuperAdmin()
        || (
          signedIn()
          && (
            targetType == "all"
            || (
              targetType == "class"
              && (isClassMember(targetClassId) || managesClass(targetClassId))
            )
          )
        );
    }

    match /profileIds/{profileId} {
      // Profile IDs are permanent. 3228667330 is reserved for the existing Super Admin account.
      allow get: if rawSignedIn();
      allow list: if isSuperAdmin();

      allow create: if signedIn()
        && profileId != "3228667330"
        && !exists(/databases/$(database)/documents/profileIds/$(profileId))
        && request.resource.data.uid == request.auth.uid;

      allow update, delete: if false;
    }

    match /studentLoginAliases/{aliasId} {
      // Exact alias lookup is available before sign-in; listing is never public.
      allow get: if true;
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin()
        || (
          rawSignedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.loginEmail == request.auth.token.email
          && (!exists(/databases/$(database)/documents/studentLoginAliases/$(aliasId))
            || resource.data.uid == request.auth.uid)
        );
      allow delete: if isSuperAdmin();
    }


    match /teacherLoginAliases/{aliasId} {
      // Exact teacher alias lookup is allowed before sign-in so name + password login can resolve the email.
      // Listing the directory is never public.
      allow get: if true;
      allow list: if isSuperAdmin();

      allow create, update: if isSuperAdmin()
        || (
          rawSignedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.loginEmail == request.auth.token.email
          && isTeacher()
          && (!exists(/databases/$(database)/documents/teacherLoginAliases/$(aliasId))
            || resource.data.uid == request.auth.uid)
        );

      allow delete: if isSuperAdmin();
    }

    match /publicProfiles/{uid} {
      // Searchable chat directory: deliberately contains no email, password or security phrase.
      allow read, list: if signedIn();

      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.searchName is string
        && request.resource.data.searchName.size() <= 40
        && request.resource.data.role in ["student", "teacher"]
        && (request.resource.data.role != "teacher" || isTeacher())
        && request.resource.data.profileId is string
        && request.resource.data.profileId.size() <= 10
        && request.resource.data.photoData is string
        && request.resource.data.photoData.size() <= 140000
        && request.resource.data.keys().hasOnly([
          "uid",
          "displayName",
          "searchName",
          "role",
          "profileId",
          "photoData",
          "updatedAt"
        ]);

      allow delete: if isSuperAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /blockedUsers/{uid} {
      allow get: if rawSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    match /codes/{code} {
      allow get: if signedIn();
      allow list: if isSuperAdmin();

      allow create: if isTeacher()
        && !exists(/databases/$(database)/documents/codes/$(code))
        && request.resource.data.ownerId == request.auth.uid;

      allow update, delete: if isSuperAdmin();
    }

    match /classJoinCodes/{code} {
      allow get: if signedIn();
      allow list: if isSuperAdmin();

      allow create: if isSuperAdmin()
        || (
          isTeacher()
          && request.resource.data.ownerId == request.auth.uid
          && get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.ownerId
             == request.auth.uid
        );

      allow update: if isSuperAdmin()
        || (signedIn() && managesClass(resource.data.classId));

      allow delete: if isSuperAdmin()
        || (signedIn() && ownsClass(resource.data.classId));
    }

    match /teacherInvites/{code} {
      allow get: if isTeacher();
      allow list: if isSuperAdmin();

      allow create: if isTeacher()
        && request.resource.data.createdBy == request.auth.uid
        && managesClass(request.resource.data.classId);

      allow update, delete: if isSuperAdmin()
        || (isTeacher() && managesClass(resource.data.classId));
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.resource.data.role in ["student", "teacher"]
        && (request.resource.data.role != "teacher" || request.auth.token.firebase.sign_in_provider == "google.com" || isSuperAdmin())
        && request.auth.uid == uid
        && request.resource.data.profileId is string
        && !request.resource.data.keys().hasAny([
          "recoveryKeyHash",
          "recoveryKeyVersion",
          "recoveryKeySetAt"
        ])
        && get(/databases/$(database)/documents/profileIds/$(request.resource.data.profileId)).data.uid == request.auth.uid;

      allow read: if isSuperAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isSuperAdmin();

      allow update: if (isSuperAdmin() && (isOwnerAdmin() || resource.data.profileId != "3228667330"))
        || (
          signedIn()
          && request.auth.uid == uid
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["role"])
            || (request.auth.token.firebase.sign_in_provider == "google.com" && request.resource.data.role == "teacher"))
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            "recoveryKeyHash",
            "recoveryKeyVersion",
            "recoveryKeySetAt"
          ])
          && (
            (
              "profileId" in resource.data
              && request.resource.data.profileId == resource.data.profileId
            )
            || (
              !("profileId" in resource.data)
              && request.resource.data.profileId is string
              && get(/databases/$(database)/documents/profileIds/$(request.resource.data.profileId)).data.uid == request.auth.uid
            )
          )
        );

      allow delete: if (isSuperAdmin() && (isOwnerAdmin() || resource.data.profileId != "3228667330")) || (signedIn() && request.auth.uid == uid && resource.data.profileId != "3228667330");
    }

    match /classes/{classId} {
      allow get: if isSuperAdmin() || (
        signedIn() && (
          ownsClass(classId)
          || isCoTeacher(classId)
          || isClassMember(classId)
        )
      );

      allow list: if isTeacher();

      allow create: if isTeacher()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if isSuperAdmin()
        || ownsClass(classId)
        || (
          isCoTeacher(classId)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.code == resource.data.code
        );

      allow delete: if isSuperAdmin() || ownsClass(classId);

      match /teachers/{uid} {
        allow read: if isSuperAdmin() || managesClass(classId);
        allow list: if isSuperAdmin() || managesClass(classId);

        allow create: if isSuperAdmin()
          || ownsClass(classId)
          || (
            isTeacher()
            && request.auth.uid == uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.inviteCode is string
            && get(/databases/$(database)/documents/teacherInvites/$(request.resource.data.inviteCode)).data.classId
               == classId
            && get(/databases/$(database)/documents/teacherInvites/$(request.resource.data.inviteCode)).data.active
               == true
          );

        allow update: if isSuperAdmin()
          || managesClass(classId)
          || (isTeacher() && request.auth.uid == uid);

        allow delete: if isSuperAdmin()
          || ownsClass(classId)
          || (isTeacher() && request.auth.uid == uid);
      }

      match /members/{uid} {
        // A student can see the roster only for a class they already belong to.
        allow read: if isSuperAdmin()
          || managesClass(classId)
          || isClassMember(classId);
        allow list: if isSuperAdmin()
          || managesClass(classId)
          || isClassMember(classId);

        // Super Admin may place a student in a class directly.
        // A student may also create their own membership again after leaving,
        // as long as they provide an active valid class code.
        // A valid active class code always allows the student to rejoin after leaving/removal.
        allow create: if isSuperAdmin()
          || (
            signedIn()
            && request.auth.uid == uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.joinCode is string
            && get(/databases/$(database)/documents/classJoinCodes/$(request.resource.data.joinCode)).data.classId
               == classId
            && get(/databases/$(database)/documents/classJoinCodes/$(request.resource.data.joinCode)).data.active
               == true
          );

        allow update: if isSuperAdmin()
          || managesClass(classId)
          || (
            signedIn()
            && request.auth.uid == uid
            && request.resource.data.uid == resource.data.uid
          );

        allow delete: if isSuperAdmin()
          || managesClass(classId)
          || (signedIn() && request.auth.uid == uid);
      }

      match /activity/{activityId} {
        allow read, list: if isSuperAdmin() || managesClass(classId);

        allow create: if signedIn()
          && request.resource.data.studentUid == request.auth.uid
          && isClassMember(classId);

        allow update: if isSuperAdmin();
        allow delete: if isSuperAdmin() || managesClass(classId);
      }

      match /assignments/{assignmentId} {
        allow read: if isSuperAdmin() || managesClass(classId) || isClassMember(classId);
        allow list: if isSuperAdmin() || managesClass(classId) || isClassMember(classId);

        allow create, update, delete: if isSuperAdmin() || managesClass(classId);

        match /answerKey/{questionId} {
          allow read, list, create, update, delete: if isSuperAdmin() || managesClass(classId);
        }

        match /submissions/{uid} {
          allow read: if isSuperAdmin()
            || managesClass(classId)
            || (signedIn() && request.auth.uid == uid);
          allow list: if isSuperAdmin() || managesClass(classId);

          allow create: if signedIn()
            && request.auth.uid == uid
            && request.resource.data.studentUid == request.auth.uid
            && isClassMember(classId);

          // Super Admin may edit the grade multiple times.
          allow update: if (
              isSuperAdmin()
              && request.resource.data.adminGradeEditedBy == request.auth.uid
              && request.resource.data.finalScore is number
              && request.resource.data.finalScore >= 0
              && request.resource.data.finalScore <= request.resource.data.totalPoints
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "finalScore",
                "teacherReviewed",
                "adminGradeEditedAt",
                "adminGradeEditedBy",
                "updatedAt"
              ])
            )
            || (
              !isSuperAdmin()
              && managesClass(classId)
            );

          allow delete: if isSuperAdmin() || managesClass(classId);
        }
      }
    }

    match /questionBanks/{uid}/questions/{questionId} {
      allow read, create, update, delete: if isSuperAdmin()
        || (isTeacher() && request.auth.uid == uid);
    }

    match /exams/{examId} {
      allow create: if isTeacher()
        && request.resource.data.ownerId == request.auth.uid;

      allow update, delete: if isSuperAdmin()
        || (isTeacher() && resource.data.ownerId == request.auth.uid);

      allow read: if isSuperAdmin() || (signedIn() && (
        resource.data.published == true
        || resource.data.ownerId == request.auth.uid
      ));

      match /questions/{questionId} {
        allow create, update, delete: if ownsExam(examId);
        allow read: if ownsExam(examId)
          || (
            signedIn()
            && get(/databases/$(database)/documents/exams/$(examId)).data.published == true
          );
      }

      match /answerKey/{questionId} {
        allow read, write: if ownsExam(examId);
      }
    }

    match /attempts/{attemptId} {
      allow create: if signedIn()
        && request.resource.data.studentUid == request.auth.uid;

      allow read: if isSuperAdmin() || (signedIn() && (
        resource.data.studentUid == request.auth.uid
        || ownsExam(resource.data.examId)
      ));

      allow update: if isSuperAdmin() || ownsExam(resource.data.examId);
      allow delete: if isSuperAdmin();

      match /answers/{answerId} {
        allow create, update, read: if isSuperAdmin()
          || ownsAttempt(attemptId)
          || ownsExam(
            get(/databases/$(database)/documents/attempts/$(attemptId)).data.examId
          );
        allow delete: if isSuperAdmin();
      }
    }

    match /competitions/{compId} {
      allow read: if signedIn();
      allow list: if signedIn();

      allow create: if isTeacher()
        && request.resource.data.ownerId == request.auth.uid;

      allow update, delete: if isSuperAdmin()
        || (isTeacher() && resource.data.ownerId == request.auth.uid);

      match /questions/{questionId} {
        allow read, write: if ownsCompetition(compId);
      }

      match /players/{uid} {
        allow read: if signedIn();

        allow create: if signedIn()
          && canJoinCompetition(compId)
          && request.auth.uid == uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.score == 0
          && request.resource.data.team in ["A", "B", "SOLO"];

        allow update: if isSuperAdmin()
          || ownsCompetition(compId)
          || (
            signedIn()
            && request.auth.uid == uid
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.score == resource.data.score
            && request.resource.data.team in ["A", "B", "SOLO"]
          );

        allow delete: if isSuperAdmin() || ownsCompetition(compId);
      }

      match /responses/{responseId} {
        allow read: if isSuperAdmin() || ownsCompetition(compId);

        allow create: if signedIn()
          && request.resource.data.studentUid == request.auth.uid
          && get(/databases/$(database)/documents/competitions/$(compId)).data.status == "question"
          && request.resource.data.questionIndex
             == get(/databases/$(database)/documents/competitions/$(compId)).data.currentIndex;

        allow update: if isSuperAdmin();
        allow delete: if isSuperAdmin() || ownsCompetition(compId);
      }
    }

    match /adminAnnouncements/{announcementId} {
      allow read: if canReadTarget(resource.data.targetType, resource.data.targetClassId);
      allow create, update, delete: if isSuperAdmin();
    }

    match /adminPolls/{pollId} {
      allow read: if canReadTarget(resource.data.targetType, resource.data.targetClassId);
      allow create, update, delete: if isSuperAdmin();

      match /votes/{uid} {
        allow read: if isSuperAdmin()
          || canReadTarget(
            get(/databases/$(database)/documents/adminPolls/$(pollId)).data.targetType,
            get(/databases/$(database)/documents/adminPolls/$(pollId)).data.targetClassId
          );

        // One account = one vote. The vote document ID is the user's UID.
        // Once created, it cannot be changed by the voter.
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.optionIndex is int
          && canReadTarget(
            get(/databases/$(database)/documents/adminPolls/$(pollId)).data.targetType,
            get(/databases/$(database)/documents/adminPolls/$(pollId)).data.targetClassId
          );

        allow update: if false;
        allow delete: if isSuperAdmin();
      }
    }




    function canUseChat() { return signedIn() && !exists(/databases/$(database)/documents/chatRestrictions/$(request.auth.uid)); }
    function channelMember(root, id) {
      let channel = get(/databases/$(database)/documents/$(root)/$(id)).data;
      return signedIn() && ((root == 'supportRequests' && (isSupportAgent() || channel.createdBy == request.auth.uid))
        || (root in ['chats','groupChats'] && request.auth.uid in channel.participantIds));
    }
    function channelCanSend(root,id) {
      return channelMember(root,id) && (root == 'supportRequests' || (canUseChat()
        && (root != 'chats' || directChatUnblocked(get(/databases/$(database)/documents/chats/$(id)).data))));
    }
    function validMessageMedia(root,id,data) {
      return !('mediaId' in data) || (data.mediaId is string
        && getAfter(/databases/$(database)/documents/$(root)/$(id)/media/$(data.mediaId)).data.senderUid == request.auth.uid);
    }
    match /{chatRoot}/{chatId}/media/{mediaId} {
      allow read: if chatRoot in ['chats','groupChats','supportRequests'] && channelMember(chatRoot,chatId);
      allow create: if chatRoot in ['chats','groupChats','supportRequests'] && channelCanSend(chatRoot,chatId)
        && request.resource.data.keys().hasOnly(['senderUid','contentType','data','createdAt'])
        && request.resource.data.senderUid == request.auth.uid && request.resource.data.createdAt == request.time
        && request.resource.data.contentType in ['image/jpeg','image/png','image/webp','audio/webm','audio/ogg','audio/mp4']
        && request.resource.data.data is string && request.resource.data.data.size() > 0 && request.resource.data.data.size() <= 655360
        && getAfter(/databases/$(database)/documents/$(chatRoot)/$(chatId)/messages/$(mediaId)).data.mediaId == mediaId
        && getAfter(/databases/$(database)/documents/$(chatRoot)/$(chatId)/messages/$(mediaId)).data.senderUid == request.auth.uid;
      allow update,delete: if false;
    }
    match /{chatRoot}/{chatId}/presence/{uid} {
      function fresh(field) { return !(field in request.resource.data) || request.resource.data[field] == request.time
        || (resource != null && resource.data.get(field,null) == request.resource.data[field]); }
      allow read: if chatRoot in ['chats','groupChats','supportRequests'] && channelMember(chatRoot,chatId);
      allow create,update: if chatRoot in ['chats','groupChats','supportRequests'] && request.auth.uid == uid && channelCanSend(chatRoot,chatId)
        && request.resource.data.keys().hasOnly(['typing','typingAt','lastReadAt'])
        && (!('typing' in request.resource.data) || request.resource.data.typing is bool)
        && fresh('typingAt') && fresh('lastReadAt');
      allow delete: if false;
    }
    match /chatRestrictions/{uid} { allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin()); allow write: if false; }
    match /accountActionRequests/{id} {
      allow read: if signedIn() && (resource.data.targetUid == request.auth.uid || isSuperAdmin());
      allow update: if signedIn() && resource.data.targetUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status == 'acknowledged';
      allow create,delete: if false;
    }

    function supportTextAllowed(text) {
      return text is string && text.size() > 0 && text.size() <= 1500
        && text.matches('^[\\x{0009}\\x{000A}\\x{000D}\\x{0020}-\\x{007E}\\x{0621}-\\x{063A}\\x{0641}-\\x{0652}\\x{0671}\\x{0660}-\\x{0669}\\x{061F}\\x{060C}\\x{061B}\\x{00A9}\\x{00AE}\\x{00AB}\\x{00BB}\\x{2013}-\\x{2014}\\x{2026}\\x{2022}\\x{2019}\\x{201C}-\\x{201D}\\x{2705}\\x{26A0}\\x{1F300}-\\x{1FAFF}\\x{2600}-\\x{26FF}\\x{2764}\\x{00B0}\\x{00D7}\\x{00F7}\\x{20AC}\\x{00A3}\\x{20AA}\\x{200D}\\x{FE0F}\\x{1F1E6}-\\x{1F1FF}]*$');
    }
    function directChatUnblocked(data) {
      return !exists(/databases/$(database)/documents/users/$(data.participantIds[0])/chatBlocks/$(data.participantIds[1]))
        && !exists(/databases/$(database)/documents/users/$(data.participantIds[1])/chatBlocks/$(data.participantIds[0]));
    }
    match /users/{uid}/chatPreferences/{chatId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nickname','favorite','hiddenAt'])
        && (!('nickname' in request.resource.data) || (request.resource.data.nickname is string && request.resource.data.nickname.size() <= 40))
        && (!('favorite' in request.resource.data) || request.resource.data.favorite is bool)
        && (!('hiddenAt' in request.resource.data) || request.resource.data.hiddenAt is timestamp);
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    match /users/{uid}/chatBlocks/{otherUid} {
      allow get: if signedIn() && request.auth.uid in [uid,otherUid];
      allow list: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && uid != otherUid
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    match /groupChats/{groupId} {
      function member() { return signedIn() && request.auth.uid in resource.data.participantIds; }
      allow get: if signedIn();
      allow list: if member();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name','ownerId','participantIds','createdAt','updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.participantIds == [request.auth.uid]
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantIds'])
          && request.resource.data.participantIds is list && request.resource.data.participantIds.size() <= 20
          && (request.resource.data.participantIds == resource.data.participantIds.removeAll([request.auth.uid])
            || (!(request.auth.uid in resource.data.participantIds) && request.resource.data.participantIds == resource.data.participantIds.concat([request.auth.uid]))
            || request.resource.data.participantIds == resource.data.participantIds))
        || (member() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','lastSenderUid','updatedAt'])
          && request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 180
          && request.resource.data.lastSenderUid == request.auth.uid && request.resource.data.updatedAt == request.time));
      allow delete: if false;
      match /messages/{messageId} {
        function parentGroup() { return get(/databases/$(database)/documents/groupChats/$(groupId)).data; }
        allow read: if signedIn() && request.auth.uid in parentGroup().participantIds;
        allow create: if canUseChat() && request.auth.uid in parentGroup().participantIds
          && validMessageMedia('groupChats',groupId,request.resource.data)
          && request.resource.data.keys().hasOnly(['senderUid','text','createdAt','mediaId'])
          && request.resource.data.senderUid == request.auth.uid && request.resource.data.createdAt == request.time
          && request.resource.data.text is string && (request.resource.data.text.size() > 0 || 'mediaId' in request.resource.data) && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }
    match /{chatRoot}/{chatId}/activity/{activityId} {
      function parent() { return get(/databases/$(database)/documents/$(chatRoot)/$(chatId)).data; }
      function linkedMessage() { return getAfter(/databases/$(database)/documents/$(chatRoot)/$(chatId)/messages/$(request.resource.data.messageId)).data; }
      allow read: if chatRoot in ['chats','groupChats'] && signedIn() && request.auth.uid in parent().participantIds;
      allow create, update: if chatRoot in ['chats','groupChats'] && signedIn() && request.auth.uid in parent().participantIds
        && request.resource.data.keys().hasOnly(['senderUid','day','messageId','updatedAt'])
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.day == request.time.date() && request.resource.data.updatedAt == request.time
        && (!exists(/databases/$(database)/documents/$(chatRoot)/$(chatId)/activity/$(activityId)) || resource.data.senderUid == request.auth.uid)
        && linkedMessage().senderUid == request.auth.uid && linkedMessage().createdAt.date() == request.time.date();
      allow delete: if false;
    }

    match /chats/{chatId} {
      function isParticipant() {
        return signedIn() && request.auth.uid in resource.data.participantIds;
      }

      allow read: if isParticipant();

      allow create: if signedIn()
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds[0] != request.resource.data.participantIds[1]
        && directChatUnblocked(request.resource.data)
        && request.resource.data.participantNames is map
        && request.resource.data.keys().hasOnly([
          "participantIds",
          "participantNames",
          "updatedAt"
        ]);

      allow update: if signedIn()
        && directChatUnblocked(resource.data)
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "participantNames",
          "lastMessage",
          "lastSenderUid",
          "updatedAt"
        ]);

      allow delete: if isSuperAdmin();

      match /messages/{messageId} {
        function parentChat() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }

        allow read: if signedIn()
          && request.auth.uid in parentChat().participantIds;

        allow create: if canUseChat()
          && validMessageMedia("chats",chatId,request.resource.data)
          && request.auth.uid in parentChat().participantIds
          && directChatUnblocked(parentChat())
          && request.resource.data.createdAt == request.time
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && (request.resource.data.text.size() > 0 || "mediaId" in request.resource.data)
          && request.resource.data.text.size() <= 2000
          && request.resource.data.keys().hasOnly([
            "senderUid",
            "text",
            "mediaId",
            "createdAt"
          ]);

        allow update, delete: if false;
      }
    }

    match /supportRequests/{requestId} {
      // A support request can be created from the login screen.
      // It is strictly field-limited and is never publicly readable.
      allow create: if request.resource.data.keys().hasOnly([
          "type",
          "reportedUid", "reportedName", "reportedProfileId", "createdByProfileId",
          "accountIdentifier",
          "claimedUid",
          "securityProofHash",
          "message",
          "createdBy",
          "createdByName",
          "status",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.type in [
          "forgot_password",
          "account_access",
          "bug",
          "report_user",
          "suggestion",
          "other"
        ]
        && (!('reportedUid' in request.resource.data) || (request.resource.data.reportedUid is string && request.resource.data.reportedUid.size() <= 128))
        && (!('reportedName' in request.resource.data) || (request.resource.data.reportedName is string && request.resource.data.reportedName.size() <= 80))
        && (!('reportedProfileId' in request.resource.data) || (request.resource.data.reportedProfileId is string && request.resource.data.reportedProfileId.size() <= 40))
        && (!('createdByProfileId' in request.resource.data) || (request.resource.data.createdByProfileId is string && request.resource.data.createdByProfileId.size() <= 40))
        && request.resource.data.status == "open"
        && request.resource.data.accountIdentifier is string
        && request.resource.data.accountIdentifier.size() <= 80
        && request.resource.data.claimedUid is string
        && request.resource.data.claimedUid.size() <= 128
        && request.resource.data.securityProofHash is string
        && request.resource.data.securityProofHash.size() <= 64
        && supportTextAllowed(request.resource.data.message)
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 1500
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy is string
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() <= 80
        && (
          (request.auth == null && request.resource.data.createdBy == "")
          || (
            signedIn()
            && request.resource.data.createdBy == request.auth.uid
          )
        );

      allow read, list: if isSupportAgent()
        || (
          signedIn()
          && resource.data.createdBy == request.auth.uid
        );

      allow update: if (signedIn() && resource.data.createdBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])
        && request.resource.data.updatedAt == request.time) || isSuperAdmin() || (
        isSupportAgent()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "adminReply", "repliedAt", "repliedBy", "status", "resolvedAt", "resolvedBy", "updatedAt"
        ])
        && request.resource.data.status in ["open","resolved"]
        && (!("adminReply" in request.resource.data)
          || (request.resource.data.adminReply is string && request.resource.data.adminReply.size() <= 1500))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["repliedBy"]) || request.resource.data.repliedBy == request.auth.uid)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["resolvedBy"]) || request.resource.data.resolvedBy == request.auth.uid)
      );
      allow delete: if isSuperAdmin();
      match /messages/{messageId} {
        function ticket() { return get(/databases/$(database)/documents/supportRequests/$(requestId)).data; }
        allow read: if signedIn() && (isSupportAgent() || ticket().createdBy == request.auth.uid);
        allow create: if signedIn() && (isSupportAgent() || ticket().createdBy == request.auth.uid)
          && request.resource.data.keys().hasOnly(['senderUid','text','staff','senderName','createdAt','mediaId'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.staff is bool
          && request.resource.data.staff == isSupportAgent()
          && request.resource.data.senderName is string && request.resource.data.senderName.size() <= 80
          && request.resource.data.createdAt == request.time
          && (supportTextAllowed(request.resource.data.text) || (request.resource.data.text == '' && 'mediaId' in request.resource.data))
          && validMessageMedia('supportRequests',requestId,request.resource.data);
        allow update, delete: if false;
      }
    }

    match /siteControls/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    match /adminAudit/{logId} {
      allow read, create: if isSuperAdmin();
      allow update, delete: if false;
    }

    // Server-only Classora support/recovery data.
    // Browser clients never read or write these collections directly.
    // Callable Cloud Functions use the Admin SDK and bypass Firestore rules.
    match /supportTickets/{ticketId} {
      allow read, write: if false;
    }

    match /supportAudit/{eventId} {
      allow read: if isSuperAdmin() || (isSupportAgent() && resource.data.actor == request.auth.uid);
      allow write: if false;
    }

    match /recoveryKeyLookup/{keyHash} {
      allow read, write: if false;
    }

    match /recoverySecrets/{uid} {
      allow read, write: if false;
    }

    match /_recoveryRate/{rateId} {
      allow read, write: if false;
    }

    match /_supportRate/{rateId} {
      allow read, write: if false;
    }

  }
}
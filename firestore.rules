rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function rawSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return rawSignedIn()
        && exists(/databases/$(database)/documents/profileIds/3228667330)
        && get(/databases/$(database)/documents/profileIds/3228667330).data.uid == request.auth.uid;
    }

    function isBlocked() {
      return rawSignedIn()
        && !isSuperAdmin()
        && exists(/databases/$(database)/documents/blockedUsers/$(request.auth.uid));
    }

    function signedIn() {
      return rawSignedIn() && !isBlocked();
    }

    function isTeacher() {
      return signedIn() && (
        isSuperAdmin()
        || request.auth.token.firebase.sign_in_provider == "google.com"
      );
    }

    function ownsClass(classId) {
      return isTeacher()
        && get(/databases/$(database)/documents/classes/$(classId)).data.ownerId
           == request.auth.uid;
    }

    function isCoTeacher(classId) {
      return isTeacher()
        && exists(/databases/$(database)/documents/classes/$(classId)/teachers/$(request.auth.uid));
    }

    function managesClass(classId) {
      return isSuperAdmin() || ownsClass(classId) || isCoTeacher(classId);
    }

    function isClassMember(classId) {
      return signedIn()
        && exists(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid));
    }

    function ownsExam(examId) {
      return isSuperAdmin() || (
        isTeacher()
        && get(/databases/$(database)/documents/exams/$(examId)).data.ownerId
           == request.auth.uid
      );
    }

    function ownsAttempt(attemptId) {
      return signedIn()
        && get(/databases/$(database)/documents/attempts/$(attemptId)).data.studentUid
           == request.auth.uid;
    }

    function ownsCompetition(compId) {
      return isSuperAdmin() || (
        isTeacher()
        && get(/databases/$(database)/documents/competitions/$(compId)).data.ownerId
           == request.auth.uid
      );
    }

    function canJoinCompetition(compId) {
      let c = get(/databases/$(database)/documents/competitions/$(compId)).data;
      return isSuperAdmin()
        || !("targetType" in c)
        || c.targetType == "all"
        || (c.targetType == "class" && isClassMember(c.targetClassId));
    }

    function canReadTarget(targetType, targetClassId) {
      return isSuperAdmin()
        || (
          signedIn()
          && (
            targetType == "all"
            || (
              targetType == "class"
              && (isClassMember(targetClassId) || managesClass(targetClassId))
            )
          )
        );
    }

    match /profileIds/{profileId} {
      // Profile IDs are permanent. 3228667330 is reserved for the existing Super Admin account.
      allow get: if rawSignedIn();
      allow list: if isSuperAdmin();

      allow create: if signedIn()
        && profileId != "3228667330"
        && !exists(/databases/$(database)/documents/profileIds/$(profileId))
        && request.resource.data.uid == request.auth.uid;

      allow update, delete: if false;
    }

    match /studentLoginAliases/{aliasId} {
      // Exact alias lookup is available before sign-in; listing is never public.
      allow get: if true;
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin()
        || (
          rawSignedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.loginEmail == request.auth.token.email
        );
      allow delete: if isSuperAdmin();
    }

    match /blockedUsers/{uid} {
      allow get: if rawSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    match /codes/{code} {
      allow get: if signedIn();
      allow list: if isSuperAdmin();

      allow create: if isTeacher()
        && !exists(/databases/$(database)/documents/codes/$(code))
        && request.resource.data.ownerId == request.auth.uid;

      allow update, delete: if isSuperAdmin();
    }

    match /classJoinCodes/{code} {
      allow get: if signedIn();
      allow list: if isSuperAdmin();

      allow create: if isSuperAdmin()
        || (
          isTeacher()
          && request.resource.data.ownerId == request.auth.uid
          && get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.ownerId
             == request.auth.uid
        );

      allow update: if isSuperAdmin()
        || (signedIn() && managesClass(resource.data.classId));

      allow delete: if isSuperAdmin()
        || (signedIn() && ownsClass(resource.data.classId));
    }

    match /teacherInvites/{code} {
      allow get: if isTeacher();
      allow list: if isSuperAdmin();

      allow create: if isTeacher()
        && request.resource.data.createdBy == request.auth.uid
        && managesClass(request.resource.data.classId);

      allow update, delete: if isSuperAdmin()
        || (isTeacher() && managesClass(resource.data.classId));
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.profileId is string
        && get(/databases/$(database)/documents/profileIds/$(request.resource.data.profileId)).data.uid == request.auth.uid;

      allow read: if isSuperAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isSuperAdmin();

      allow update: if isSuperAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && (
            (
              "profileId" in resource.data
              && request.resource.data.profileId == resource.data.profileId
            )
            || (
              !("profileId" in resource.data)
              && request.resource.data.profileId is string
              && get(/databases/$(database)/documents/profileIds/$(request.resource.data.profileId)).data.uid == request.auth.uid
            )
          )
        );

      allow delete: if isSuperAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /classes/{classId} {
      allow get: if isSuperAdmin() || (
        signedIn() && (
          ownsClass(classId)
          || isCoTeacher(classId)
          || isClassMember(classId)
        )
      );

      allow list: if isTeacher();

      allow create: if isTeacher()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if isSuperAdmin()
        || ownsClass(classId)
        || (
          isCoTeacher(classId)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.code == resource.data.code
        );

      allow delete: if isSuperAdmin() || ownsClass(classId);

      match /teachers/{uid} {
        allow read: if isSuperAdmin() || managesClass(classId);
        allow list: if isSuperAdmin() || managesClass(classId);

        allow create: if isSuperAdmin()
          || ownsClass(classId)
          || (
            isTeacher()
            && request.auth.uid == uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.inviteCode is string
            && get(/databases/$(database)/documents/teacherInvites/$(request.resource.data.inviteCode)).data.classId
               == classId
            && get(/databases/$(database)/documents/teacherInvites/$(request.resource.data.inviteCode)).data.active
               == true
          );

        allow update: if isSuperAdmin()
          || managesClass(classId)
          || (isTeacher() && request.auth.uid == uid);

        allow delete: if isSuperAdmin()
          || ownsClass(classId)
          || (isTeacher() && request.auth.uid == uid);
      }

      match /members/{uid} {
        // A student can see the roster only for a class they already belong to.
        allow read: if isSuperAdmin()
          || managesClass(classId)
          || isClassMember(classId);
        allow list: if isSuperAdmin()
          || managesClass(classId)
          || isClassMember(classId);

        // Super Admin may place a student in a class directly.
        // A student may also create their own membership again after leaving,
        // as long as they provide an active valid class code.
        // A valid active class code always allows the student to rejoin after leaving/removal.
        allow create: if isSuperAdmin()
          || (
            signedIn()
            && request.auth.uid == uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.joinCode is string
            && get(/databases/$(database)/documents/classJoinCodes/$(request.resource.data.joinCode)).data.classId
               == classId
            && get(/databases/$(database)/documents/classJoinCodes/$(request.resource.data.joinCode)).data.active
               == true
          );

        allow update: if isSuperAdmin()
          || managesClass(classId)
          || (
            signedIn()
            && request.auth.uid == uid
            && request.resource.data.uid == resource.data.uid
          );

        allow delete: if isSuperAdmin()
          || managesClass(classId)
          || (signedIn() && request.auth.uid == uid);
      }

      match /activity/{activityId} {
        allow read, list: if isSuperAdmin() || managesClass(classId);

        allow create: if signedIn()
          && request.resource.data.studentUid == request.auth.uid
          && isClassMember(classId);

        allow update: if isSuperAdmin();
        allow delete: if isSuperAdmin() || managesClass(classId);
      }

      match /assignments/{assignmentId} {
        allow read: if isSuperAdmin() || managesClass(classId) || isClassMember(classId);
        allow list: if isSuperAdmin() || managesClass(classId) || isClassMember(classId);

        allow create, update, delete: if isSuperAdmin() || managesClass(classId);

        match /answerKey/{questionId} {
          allow read, list, create, update, delete: if isSuperAdmin() || managesClass(classId);
        }

        match /submissions/{uid} {
          allow read: if isSuperAdmin()
            || managesClass(classId)
            || (signedIn() && request.auth.uid == uid);
          allow list: if isSuperAdmin() || managesClass(classId);

          allow create: if signedIn()
            && request.auth.uid == uid
            && request.resource.data.studentUid == request.auth.uid
            && isClassMember(classId);

          // Super Admin may edit the grade multiple times.
          allow update: if (
              isSuperAdmin()
              && request.resource.data.adminGradeEditedBy == request.auth.uid
              && request.resource.data.finalScore is number
              && request.resource.data.finalScore >= 0
              && request.resource.data.finalScore <= request.resource.data.totalPoints
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "finalScore",
                "teacherReviewed",
                "adminGradeEditedAt",
                "adminGradeEditedBy",
                "updatedAt"
              ])
            )
            || (
              !isSuperAdmin()
              && managesClass(classId)
            );

          allow delete: if isSuperAdmin() || managesClass(classId);
        }
      }
    }

    match /questionBanks/{uid}/questions/{questionId} {
      allow read, create, update, delete: if isSuperAdmin()
        || (isTeacher() && request.auth.uid == uid);
    }

    match /exams/{examId} {
      allow create: if isTeacher()
        && request.resource.data.ownerId == request.auth.uid;

      allow update, delete: if isSuperAdmin()
        || (isTeacher() && resource.data.ownerId == request.auth.uid);

      allow read: if isSuperAdmin() || (signedIn() && (
        resource.data.published == true
        || resource.data.ownerId == request.auth.uid
      ));

      match /questions/{questionId} {
        allow create, update, delete: if ownsExam(examId);
        allow read: if ownsExam(examId)
          || (
            signedIn()
            && get(/databases/$(database)/documents/exams/$(examId)).data.published == true
          );
      }

      match /answerKey/{questionId} {
        allow read, write: if ownsExam(examId);
      }
    }

    match /attempts/{attemptId} {
      allow create: if signedIn()
        && request.resource.data.studentUid == request.auth.uid;

      allow read: if isSuperAdmin() || (signedIn() && (
        resource.data.studentUid == request.auth.uid
        || ownsExam(resource.data.examId)
      ));

      allow update: if isSuperAdmin() || ownsExam(resource.data.examId);
      allow delete: if isSuperAdmin();

      match /answers/{answerId} {
        allow create, update, read: if isSuperAdmin()
          || ownsAttempt(attemptId)
          || ownsExam(
            get(/databases/$(database)/documents/attempts/$(attemptId)).data.examId
          );
        allow delete: if isSuperAdmin();
      }
    }

    match /competitions/{compId} {
      allow read: if signedIn();
      allow list: if signedIn();

      allow create: if isTeacher()
        && request.resource.data.ownerId == request.auth.uid;

      allow update, delete: if isSuperAdmin()
        || (isTeacher() && resource.data.ownerId == request.auth.uid);

      match /questions/{questionId} {
        allow read, write: if ownsCompetition(compId);
      }

      match /players/{uid} {
        allow read: if signedIn();

        allow create: if signedIn()
          && canJoinCompetition(compId)
          && request.auth.uid == uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.score == 0
          && request.resource.data.team in ["A", "B", "SOLO"];

        allow update: if isSuperAdmin()
          || ownsCompetition(compId)
          || (
            signedIn()
            && request.auth.uid == uid
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.score == resource.data.score
            && request.resource.data.team in ["A", "B", "SOLO"]
          );

        allow delete: if isSuperAdmin() || ownsCompetition(compId);
      }

      match /responses/{responseId} {
        allow read: if isSuperAdmin() || ownsCompetition(compId);

        allow create: if signedIn()
          && request.resource.data.studentUid == request.auth.uid
          && get(/databases/$(database)/documents/competitions/$(compId)).data.status == "question"
          && request.resource.data.questionIndex
             == get(/databases/$(database)/documents/competitions/$(compId)).data.currentIndex;

        allow update: if isSuperAdmin();
        allow delete: if isSuperAdmin() || ownsCompetition(compId);
      }
    }

    match /adminAnnouncements/{announcementId} {
      allow read: if canReadTarget(resource.data.targetType, resource.data.targetClassId);
      allow create, update, delete: if isSuperAdmin();
    }

    match /adminPolls/{pollId} {
      allow read: if canReadTarget(resource.data.targetType, resource.data.targetClassId);
      allow create, update, delete: if isSuperAdmin();

      match /votes/{uid} {
        allow read: if isSuperAdmin()
          || canReadTarget(
            get(/databases/$(database)/documents/adminPolls/$(pollId)).data.targetType,
            get(/databases/$(database)/documents/adminPolls/$(pollId)).data.targetClassId
          );

        // One account = one vote. The vote document ID is the user's UID.
        // Once created, it cannot be changed by the voter.
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.optionIndex is int
          && canReadTarget(
            get(/databases/$(database)/documents/adminPolls/$(pollId)).data.targetType,
            get(/databases/$(database)/documents/adminPolls/$(pollId)).data.targetClassId
          );

        allow update: if false;
        allow delete: if isSuperAdmin();
      }
    }

    match /siteControls/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    match /adminAudit/{logId} {
      allow read, create: if isSuperAdmin();
      allow update, delete: if false;
    }

    // Server-only Classora support/recovery data.
    // Browser clients never read or write these collections directly.
    // Callable Cloud Functions use the Admin SDK and bypass Firestore rules.
    match /supportTickets/{ticketId} {
      allow read, write: if false;
    }

    match /supportAudit/{eventId} {
      allow read, write: if false;
    }

    match /recoveryKeyLookup/{keyHash} {
      allow read, write: if false;
    }

    match /recoverySecrets/{uid} {
      allow read, write: if false;
    }

    match /_recoveryRate/{rateId} {
      allow read, write: if false;
    }

    match /_supportRate/{rateId} {
      allow read, write: if false;
    }

  }
}
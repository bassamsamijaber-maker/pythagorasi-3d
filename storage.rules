rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Keep clips private to their owner. A short-lived download-token URL is
    // stored only in that user's private profile for playback.
    match /profileVideos/{uid}/avatar {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType in ['video/mp4','video/webm','video/quicktime'];
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
